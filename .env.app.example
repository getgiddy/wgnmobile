# Template for `.env.app`, which is gitignored. Copy it and fill in the values:
#
#   cp .env.app.example .env.app
#
# Everything here is compiled into the binary as a constant and is readable
# with `strings`, so only values that are safe to ship belong in this file.
# SUPABASE_DB_PASSWORD stays in `.env` — that one is for the CLI and psql.
#
# The publishable (anon) key is safe here by design: RLS protects the data, not
# the key. See supabase/migrations/0001_init.sql.
#
# Usage:
#   flutter run   --dart-define-from-file=.env.app
#   flutter build appbundle --dart-define-from-file=.env.app
#
# Values must not be quoted and must not have a leading space.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable key from Supabase → Project Settings → API Keys>

# Google OAuth client IDs — see RELEASE_CHECKLIST.md section B for how to
# create them and what else has to be registered alongside.
#
# GOOGLE_SERVER_CLIENT_ID is the *Web* client ID. It is the audience Supabase
# validates the ID token against, so it is required on every platform,
# including Android where no iOS client is involved.
# GOOGLE_IOS_CLIENT_ID is the iOS client ID, used only by the native iOS SDK.
#
# While either is blank the Google button is hidden rather than shown broken.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
